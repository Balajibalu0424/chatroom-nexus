# Supabase Configuration (from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (for server-side operations - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin control plane
ADMIN_USERNAME=admin
# Generate with: npm run admin:hash-password -- "your-strong-password"
ADMIN_PASSWORD_SCRYPT=scrypt$16384$8$1$replace_salt$replace_hash
# Same password hash, but base64 encoded to avoid deployment shell interpolation issues.
ADMIN_PASSWORD_SCRYPT_BASE64=
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret

# Upstash Redis for admin login rate limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# MeshCentral integration
MESHCENTRAL_URL=https://mesh.example.com/
MESHCENTRAL_USERID=user//integration-admin
MESHCENTRAL_LOGIN_TOKEN_KEY=replace_with_meshcentral_login_token_key_hex

# Optional: use this env catalog instead of the Supabase admin_devices table.
# Each mesh_node_id must come from an enrolled MeshCentral agent.
ADMIN_DEVICES_JSON=[{"id":"desktop","label":"Desktop","mesh_node_id":"node//replace_desktop","platform":"windows","sort_order":1},{"id":"laptop","label":"Laptop","mesh_node_id":"node//replace_laptop","platform":"windows","sort_order":2}]
# Same catalog, but base64 encoded to avoid deployment shell quoting issues.
ADMIN_DEVICES_JSON_BASE64=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
